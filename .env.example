# Copia para .env e ajusta:  cp .env.example .env

# ---- Placa de áudio principal (microfone entra aqui) ----
# Nome da placa como aparece em 'aplay -l' / 'cat /proc/asound/cards'
# (ex.: UA22, CODEC, Device, U192k). Também aceita o número (ex.: 1).
AUDIO_CARD=UA22

# ---- JACK ----
RATE=48000
# 128 amostras @48k ≈ 2,7 ms por período
PERIOD=128
# USB: se houver xruns usa 3
NPERIODS=2
JACK_PRIO=80
# opções extra do driver alsa; deixa vazio salvo necessidade
JACK_EXTRA=

# ---- Placa USB do FTDX-101D (opcional) ----
# Se o áudio processado for enviado pelo USB do rádio em vez da saída
# da placa externa, põe aqui o nome da placa do rádio (normalmente CODEC).
# Deixa vazio se ligas a saída da placa externa à entrada traseira do rádio.
FTDX_CARD=
# playback | capture | both
FTDX_DIR=playback

# ---- UI web ----
WEB_PORT=8080
# Placa cujo mixer ALSA aparece na UI (por defeito a principal)
MIXER_CARD=
# Autenticação básica (recomendado). Deixa vazio para desligar.
WEB_USER=ct2iep
WEB_PASSWORD=muda-esta-password
