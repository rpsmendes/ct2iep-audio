# Copy to .env and adjust:  cp .env.example .env
# One variable per line, NAME=value, no comments on the same line.

# ---- Main sound card (the microphone goes in here) ----
# Card name as shown by 'aplay -l' / 'cat /proc/asound/cards'
# (e.g. UA22, CODEC, Device, U192k). The card number also works (e.g. 1).
AUDIO_CARD=UA22

# ---- JACK ----
RATE=48000
# 256 samples @ 48 kHz ≈ 5.3 ms per period; 3 periods ≈ 16 ms of buffer.
# 3 periods is what JACK recommends for USB cards: with 128x2 the UA22's clock
# drift caused a burst of XRuns every ~23 s. Lower only if you need to.
PERIOD=256
NPERIODS=3
JACK_PRIO=80
# extra options for the ALSA driver; leave empty unless needed
JACK_EXTRA=

# ---- FTDX-101D USB sound card (optional, legacy) ----
# To send the processed audio to the radio's USB, choose it in the UI instead
# (Card tab -> Output). This setting is only still useful for FTDX_DIR=capture
# (receive audio from the radio into JACK). Usually CODEC.
FTDX_CARD=
# playback | capture | both
FTDX_DIR=playback

# ---- Web UI ----
WEB_PORT=8080
# Card whose ALSA mixer the UI shows by default (defaults to the main card)
MIXER_CARD=
# Basic authentication (recommended). Leave empty to disable.
WEB_USER=ct2iep
WEB_PASSWORD=change-this-password
